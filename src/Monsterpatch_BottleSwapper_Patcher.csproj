<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Monsterpatch_BottleSwapper_Patcher</AssemblyName>
    <RootNamespace>Goose.Monsterpatch.BottleSwapper</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>7.3</LangVersion>
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Monsterpatch</GameDir>
    <SharedLibDir Condition="'$(SharedLibDir)' == ''">$(MSBuildProjectDirectory)\..\..\lib</SharedLibDir>
    <Cecil Condition="Exists('$(SharedLibDir)\Mono.Cecil.dll')">$(SharedLibDir)\Mono.Cecil.dll</Cecil>
    <Cecil Condition="'$(Cecil)' == ''">$(GameDir)\BepInEx\core\Mono.Cecil.dll</Cecil>
  </PropertyGroup>
  <ItemGroup><Reference Include="Mono.Cecil"><HintPath>$(Cecil)</HintPath><Private>false</Private></Reference></ItemGroup>
  <Target Name="ValidateCecil" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(Cecil)')" Text="Missing Mono.Cecil.dll: $(Cecil)" />
  </Target>
  <Target Name="PackageRelease" AfterTargets="Build">
    <MakeDir Directories="$(MSBuildProjectDirectory)\..\Release\BepInEx\patchers" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(MSBuildProjectDirectory)\..\Release\BepInEx\patchers" />
  </Target>
</Project>